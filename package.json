{
  "name": "@apience/core",
  "version": "1.0.0",
  "description": "Express.js extension with built-in OpenAPI 3.0 documentation, validation, and type safety",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/mfursov/apience/core.git"
  },
  "homepage": "https://github.com/mfursov/apience",
  "scripts": {
    "build": "tsc --noEmit",
    "clean": "rm -rf dist",
    "format": "prettier --write \"./**/*.{ts,js,md,json}\"",
    "lint": "eslint .",
    "test": "jest",
    "webpack": "webpack",
    "release": "npm run clean && npm run webpack && npm run lint && npm run test && rimraf ./dist/tests && npm publish"
  },
  "keywords": [
    "express",
    "expressjs",
    "openapi",
    "typescript",
    "rest-api",
    "rest"
  ],
  "license": "MIT",
  "dependencies": {
    "assertic": "^1.3.0",
    "express": "^5.2.1",
    "openapi-types": "^12.1.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.27",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^9.39.2",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.2",
    "typescript": "^5.9.3",
    "webpack": "^5.99.7",
    "webpack-cli": "^5.1.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
